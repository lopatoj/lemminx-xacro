<?xml version="1.0" encoding="UTF-8" ?>
<project
  xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
>
  <modelVersion>4.0.0</modelVersion>

  <groupId>xacro.lemminx</groupId>
  <artifactId>lemminx-xacro</artifactId>
  <version>0.1.0</version>
  <name>LemMinX xacro/URDF extension</name>
  <description>Xacro and URDF language support as an extension to the LemMinX XML language server</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <lemminx.version>0.31.2</lemminx.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <!-- Provided by the LemMinX server at runtime (also brings lsp4j and gson). -->
    <dependency>
      <groupId>org.eclipse.lemminx</groupId>
      <artifactId>org.eclipse.lemminx</artifactId>
      <version>${lemminx.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>lemminx-releases</id>
      <url>https://repo.eclipse.org/content/repositories/lemminx-releases/</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <!-- Pinned so older Maven installs (whose default compiler plugin ignores maven.compiler.release) still build. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <!-- Fat "uber" LemMinX + extension jar for editors that launch LemMinX themselves (Neovim, Helix, ...).
           Run: mvn -Puber package  →  target/lemminx-xacro-*-uber.jar -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <!-- Check Maven Central for the latest release, or use 2.46.1 for Java 11 -->
        <version>2.46.1</version>
        <configuration>
          <java>
            <!-- Removes unused imports and orders the rest -->
            <removeUnusedImports />
            <importOrder />
            <!-- Applies Google Java Format (or replace with <palantirJavaFormat/> or <eclipse/>) -->
            <googleJavaFormat />
          </java>
          <pom>
            <sortPom />
          </pom>
        </configuration>
        <executions>
          <execution>
            <!-- Automatically checks formatting during 'mvn verify' or 'mvn test' -->
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>uber</id>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.lemminx</groupId>
          <artifactId>org.eclipse.lemminx</artifactId>
          <version>${lemminx.version}</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <goals>
                  <goal>shade</goal>
                </goals>
                <phase>package</phase>
                <configuration>
                  <shadedArtifactAttached>true</shadedArtifactAttached>
                  <createDependencyReducedPom>false</createDependencyReducedPom>
                  <shadedClassifierName>uber</shadedClassifierName>
                  <transformers>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                      <mainClass>org.eclipse.lemminx.XMLServerLauncher</mainClass>
                    </transformer>
                  </transformers>
                  <filters>
                    <filter>
                      <artifact>*:*</artifact>
                      <excludes>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                      </excludes>
                    </filter>
                  </filters>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
