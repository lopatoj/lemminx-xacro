<?xml version="1.0"?>
<robot name="broken" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:include filename="wheel.xacro"/>
  <xacro:include filename="missing.xacro"/>
  <link name="base_link"/>
  <xacro:wheel prefix="left" colour="red">
    <origin xyz="0 0.2 0"/>
  </xacro:wheel>
  <xacro:wheel prefix="left">
    <origin xyz="0 -0.2 0"/>
  </xacro:wheel>
  <xacro:wheeel prefix="x"/>
  <link name="arm" >
    <visual><geometry><box size="${arm_len} 0.1 0.1"/></geometry></visual>
  </link>
</robot>
