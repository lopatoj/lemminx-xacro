<?xml version="1.0"?>
<robot name="dup" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:include filename="wheel.xacro"/>
  <link name="base_link"/>
  <xacro:wheel prefix="left">
    <origin xyz="0 0.2 0"/>
  </xacro:wheel>
  <xacro:wheel prefix="left">
    <origin xyz="0 -0.2 0"/>
  </xacro:wheel>
</robot>
