<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arm" params="prefix">
    <xacro:property name="arm_len" value="0.3"/>
    <!-- the included file is evaluated in this macro's scope -->
    <xacro:include filename="arm_control.xacro"/>
  </xacro:macro>
</robot>
