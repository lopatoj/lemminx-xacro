<?xml version="1.0"?>
<robot name="demo" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_mock" default="true"/>
  <xacro:property name="wheel_radius" value="${base_width / 4}"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="base_width" value="0.4"/>
  <xacro:include filename="$(find demo_description)/urdf/materials.xacro"/>
  <xacro:include filename="wheel.xacro"/>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://demo_description/meshes/base.stl"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <xacro:wheel prefix="left">
    <origin xyz="0 ${base_width/2} 0" rpy="0 0 0"/>
  </xacro:wheel>
  <xacro:wheel prefix="right" reflect="-1">
    <origin xyz="0 ${-base_width/2} 0"/>
  </xacro:wheel>

  <ros2_control name="demo" type="system">
    <hardware>
      <xacro:if value="$(arg use_mock)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>
</robot>
